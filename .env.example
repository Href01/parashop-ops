# ---------------------------------------------------------------------------
# parashop-ops (BOS) — environment template
#
# Copy to `.env` for local work, or set the same keys in Vercel.
# Never commit real values. See docs/DEPLOYMENT.md for the production list
# and docs/MIGRATIONS_RUNBOOK.md for the release procedure.
# ---------------------------------------------------------------------------

# Runtime (usually provided by the platform)
NODE_ENV=production
# Local `next start` / realtime server port (default 3001)
PORT=3001

# Database — shared with the storefront (Neon). Secret.
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://ops.shinecosmetics.ma

# Shared password gate in front of the whole BOS (optional; empty = disabled)
GATE_PASSWORD=
# Legacy alias, still read if GATE_PASSWORD is empty
BASIC_AUTH_PASSWORD=

# Vercel Cron authentication (`Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=
# Server-to-server calls between the BOS and the storefront
INTERNAL_API_SECRET=

# Storefront coupling
# Public site used for cache revalidation
WEBSITE_URL=https://www.shinecosmetics.ma
# Storefront base URL used by BOS API routes (reviews, media, messages)
STOREFRONT_URL=https://www.shinecosmetics.ma
# Must match the storefront deployment; empty = revalidation is a silent no-op
REVALIDATE_SECRET=

# Sendit API (URL is fixed in lib/sendit.ts — not configurable)
SENDIT_PUBLIC_KEY=
SENDIT_PRIVATE_KEY=
# Pickup district used for district lookups (default 1 = Casablanca)
SENDIT_PICKUP_DISTRICT_ID=1

# Meta Conversions API / Ads
META_PIXEL_ID=
META_CAPI_TOKEN=
# Long-lived token used by the ads sync
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# Same pixel as the public site (safe to expose)
NEXT_PUBLIC_META_PIXEL_ID=
# Optional: test event code while validating CAPI
META_CAPI_TEST_CODE=
# Meta app used to refresh the ads token
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
# Optional ads sync overrides
META_DATE_PRESET=last_90d
META_FX_TO_MAD=

# Instagram content sync
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional: defaults to https://graph.instagram.com
IG_API_BASE=
# Optional: pin a Graph version
IG_GRAPH_VERSION=

# Google Search Console (SEO insights)
GSC_CLIENT_EMAIL=
# Service-account private key (literal, with \n escapes)…
GSC_PRIVATE_KEY=
# …or a path to the service-account JSON (local only)
GSC_PRIVATE_KEY_FILE=

# Neon health widget (read-only API key)
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=

# Realtime collaboration (Yjs / Hocuspocus)
NEXT_PUBLIC_REALTIME_URL=
REALTIME_TOKEN=
# BOS URL used by realtime/server.js (default https://ops.shinecosmetics.ma)
BOS_URL=

# Optional local scripts (scripts/ads/captures-site.mjs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SHOP_URL=
